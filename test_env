#!/usr/bin/env bash
# Generic tool validation only; not hackathon solution code.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
if [[ -x "$ROOT/.venv/bin/python" ]]; then
  PY="$ROOT/.venv/bin/python"
elif [[ -x "$ROOT/.venv/Scripts/python.exe" ]]; then
  PY="$ROOT/.venv/Scripts/python.exe"
else
  echo "[FAIL] .venv not found. Run ./prepare_environnement first." >&2
  exit 2
fi
exec "$PY" "$ROOT/tools/test_env.py" "$@"
