{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rb-lifeline.local/contracts/1.0.0",
  "title": "RB Lifeline publication 1.0.0",
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "metric": {"type": "object", "required": ["value", "numerator", "denominator", "unknownCount"], "properties": {"value": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "numerator": {"type": "integer", "minimum": 0}, "denominator": {"type": "integer", "minimum": 0}, "unknownCount": {"type": "integer", "minimum": 0}}},
    "counts": {"type": "object", "required": ["pressuredRoutePlays", "evaluatedPlays", "excludedUnknownPlays", "availablePlays", "availability", "targetedWhenAvailable", "completionWhenTargeted"], "properties": {"pressuredRoutePlays": {"type": "integer", "minimum": 0}, "evaluatedPlays": {"type": "integer", "minimum": 0}, "excludedUnknownPlays": {"type": "integer", "minimum": 0}, "availablePlays": {"type": "integer", "minimum": 0}, "availability": {"$ref": "#/$defs/metric"}, "targetedWhenAvailable": {"$ref": "#/$defs/metric"}, "completionWhenTargeted": {"$ref": "#/$defs/metric"}}},
    "interval": {"type": ["object", "null"], "required": ["low", "high", "level", "method", "replicates"], "properties": {"low": {"type": "number"}, "high": {"type": "number"}, "level": {"const": 0.95}, "method": {"const": "bootstrap_percentile"}, "replicates": {"type": "integer", "minimum": 1}}},
    "period": {"type": "object", "required": ["season", "weeks", "label"], "properties": {"season": {"type": "integer"}, "weeks": {"type": "array", "items": {"type": "integer"}}, "label": {"type": "string"}}},
    "parameters": {"type": "object", "required": ["pressureRadiusYd", "openDistanceYd", "maxQbDistanceYd", "minLosProgressYd", "maxFacingAngleDeg", "includeFb", "minSeasonN", "shrinkageK", "bootstrapReplicates", "randomSeed"]},
    "manifest": {"type": "object", "required": ["schemaVersion", "generationId", "generatedAt", "calculationVersion", "sourceFingerprint", "period", "parameters", "resources", "counts"], "properties": {"schemaVersion": {"const": "1.0.0"}, "generationId": {"$ref": "#/$defs/id"}, "generatedAt": {"type": "string", "format": "date-time"}, "calculationVersion": {"type": "string"}, "sourceFingerprint": {"type": "string"}, "period": {"$ref": "#/$defs/period"}, "parameters": {"$ref": "#/$defs/parameters"}, "resources": {"type": "object", "required": ["games", "seasonRb", "seasonTeam", "analysis", "quality"], "additionalProperties": {"type": "string"}}, "counts": {"type": "object", "required": ["gameCount", "playCount", "replayablePlayCount", "pressuredPlayCount", "rbObservationCount", "excludedObservationCount"], "additionalProperties": {"type": "integer", "minimum": 0}}}},
    "envelope": {"type": "object", "required": ["schemaVersion", "generationId", "data"], "properties": {"schemaVersion": {"const": "1.0.0"}, "generationId": {"$ref": "#/$defs/id"}}},
    "games": {"type": "array", "items": {"type": "object", "required": ["gameId", "season", "week", "gameDate", "homeTeam", "awayTeam", "score", "playCount", "pressuredRoutePlayCount", "gameResource"], "properties": {"gameId": {"$ref": "#/$defs/id"}, "playCount": {"type": "integer", "minimum": 0}, "gameResource": {"type": "string"}, "score": {"type": ["object", "null"]}}}},
    "check": {"type": "object", "required": ["passed", "value", "reason"], "properties": {"passed": {"type": ["boolean", "null"]}, "value": {"type": ["number", "boolean", "null"]}, "reason": {"type": ["string", "null"]}}},
    "checks": {"type": "object", "required": ["routeRunner", "open", "inRange", "pastLine", "facingQb"], "additionalProperties": {"$ref": "#/$defs/check"}},
    "observation": {"type": "object", "required": ["nflId", "status", "counted", "exclusionReason", "pressureFrameId", "checks", "targetStatus", "targeted", "completedWhenTargeted"], "properties": {"nflId": {"$ref": "#/$defs/id"}, "status": {"enum": ["available", "unavailable", "blocking", "unknown"]}, "counted": {"type": "boolean"}, "checks": {"$ref": "#/$defs/checks"}, "targeted": {"type": ["boolean", "null"]}, "completedWhenTargeted": {"type": ["boolean", "null"]}}},
    "frame": {"type": "object", "required": ["frameId", "timeS", "entities", "rbStates"], "properties": {"frameId": {"type": "integer"}, "timeS": {"type": "number"}, "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}}, "rbStates": {"type": "array", "items": {"type": "object", "required": ["nflId", "status", "checks"], "properties": {"nflId": {"$ref": "#/$defs/id"}, "status": {"enum": ["available", "unavailable", "blocking", "unknown"]}, "checks": {"$ref": "#/$defs/checks"}}}}}},
    "entity": {"type": "object", "required": ["nflId", "team", "x", "y", "o"], "properties": {"nflId": {"type": ["string", "null"]}, "team": {"type": "string"}, "x": {"type": "number"}, "y": {"type": "number"}, "o": {"type": ["number", "null"], "minimum": 0, "exclusiveMaximum": 360}}},
    "play": {"type": "object", "required": ["playId", "possessionTeam", "defensiveTeam", "quarter", "gameClock", "down", "yardsToGo", "description", "passResult", "playResult", "context", "participants", "events", "pressure", "losX", "collectiveVerdict", "target", "observations", "frames", "quality"], "properties": {"playId": {"$ref": "#/$defs/id"}, "collectiveVerdict": {"enum": ["available", "unavailable", "not_applicable", "unknown"]}, "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}}, "frames": {"type": "array", "items": {"$ref": "#/$defs/frame"}}, "quality": {"type": "object", "required": ["replayable", "countable", "reasons"], "properties": {"replayable": {"type": "boolean"}, "countable": {"type": "boolean"}, "reasons": {"type": "array", "items": {"type": "string"}}}}}},
    "game": {"type": "object", "required": ["gameId", "players", "plays", "rbSummary"], "properties": {"gameId": {"$ref": "#/$defs/id"}, "players": {"type": "object", "additionalProperties": {"type": "object", "required": ["displayName", "officialPosition", "team"]}}, "plays": {"type": "array", "items": {"$ref": "#/$defs/play"}}, "rbSummary": {"type": "array", "items": {"type": "object", "required": ["nflId", "team", "counts", "playIds"], "properties": {"nflId": {"$ref": "#/$defs/id"}, "counts": {"$ref": "#/$defs/counts"}, "playIds": {"type": "array", "items": {"$ref": "#/$defs/id"}}}, "not": {"anyOf": [{"required": ["rank"]}, {"required": ["shrunkRate"]}, {"required": ["percentile"]}, {"required": ["interval"]}]}}}}},
    "seasonRb": {"type": "object", "required": ["period", "reference", "rows"], "properties": {"period": {"$ref": "#/$defs/period"}, "reference": {"type": "object", "required": ["metricUnit", "leagueAvailability", "shrinkageK", "minN", "cohortSize"], "properties": {"metricUnit": {"const": "player_play"}, "leagueAvailability": {"type": ["number", "null"]}}}, "rows": {"type": "array", "items": {"type": "object", "required": ["nflId", "displayName", "position", "teams", "counts", "rawRate", "shrunkRate", "interval", "eligible", "rank", "percentile", "gameIds"], "properties": {"nflId": {"$ref": "#/$defs/id"}, "counts": {"$ref": "#/$defs/counts"}, "interval": {"$ref": "#/$defs/interval"}, "eligible": {"type": "boolean"}, "percentile": {"type": ["number", "null"], "minimum": 0, "maximum": 100}}}}}},
    "seasonTeam": {"type": "object", "required": ["period", "reference", "rows"], "properties": {"period": {"$ref": "#/$defs/period"}, "reference": {"type": "object", "required": ["metricUnit", "leagueAvailability", "shrinkageK", "minN", "cohortSize"], "properties": {"metricUnit": {"const": "team_play"}}}, "rows": {"type": "array", "items": {"type": "object", "required": ["team", "counts", "rawRate", "shrunkRate", "interval", "eligible", "rank", "gameIds"], "properties": {"counts": {"$ref": "#/$defs/counts"}, "interval": {"$ref": "#/$defs/interval"}}}}}},
    "comparisonGroup": {"type": "object", "required": ["playCount", "sackRate", "rbTargetRate", "rbCompletionRate"], "properties": {"playCount": {"type": "integer", "minimum": 0}, "sackRate": {"$ref": "#/$defs/metric"}, "rbTargetRate": {"$ref": "#/$defs/metric"}, "rbCompletionRate": {"$ref": "#/$defs/metric"}}},
    "difference": {"type": "object", "required": ["value", "interval", "interpretation", "reason"], "properties": {"value": {"type": ["number", "null"], "minimum": -1, "maximum": 1}, "interval": {"$ref": "#/$defs/interval"}, "interpretation": {"enum": ["descriptive", "inconclusive", "directional"]}}},
    "comparison": {"type": "object", "required": ["id", "scope", "coverageFamily", "blitz", "populationLabel", "availableGroup", "unavailableGroup", "differences"], "properties": {"availableGroup": {"$ref": "#/$defs/comparisonGroup"}, "unavailableGroup": {"$ref": "#/$defs/comparisonGroup"}, "differences": {"type": "object", "required": ["sackRate", "rbTargetRate", "rbCompletionRate"], "additionalProperties": {"$ref": "#/$defs/difference"}}}},
    "analysis": {"type": "object", "required": ["comparisonRows", "sensitivityRows"], "properties": {"comparisonRows": {"type": "array", "items": {"$ref": "#/$defs/comparison"}}, "sensitivityRows": {"type": "array", "items": {"type": "object", "required": ["variantId", "changedParameter", "parameterValue", "comparisonRows"], "properties": {"comparisonRows": {"type": "array", "items": {"$ref": "#/$defs/comparison"}}}}}}},
    "quality": {"type": "object", "required": ["inputCounts", "exclusions", "targetMatching", "pressureProxy", "prototypeDifferences"], "properties": {"inputCounts": {"type": "object"}, "exclusions": {"type": "array", "items": {"type": "object", "required": ["reason", "playCount", "observationCount"]}}, "targetMatching": {"type": "object", "required": ["thrownPassCount", "matchedCount", "unmatchedCount", "ambiguousCount", "matchRate"], "properties": {"matchRate": {"$ref": "#/$defs/metric"}}}, "pressureProxy": {"type": "object", "required": ["evaluatedPlayCount", "truePositive", "falsePositive", "trueNegative", "falseNegative", "precision", "recall", "medianTimeToPressureS"], "properties": {"precision": {"$ref": "#/$defs/metric"}, "recall": {"$ref": "#/$defs/metric"}}}, "prototypeDifferences": {"type": "array", "items": {"type": "object", "required": ["metric", "referenceValue", "recalculatedValue", "explanation"]}}}}
  }
}
